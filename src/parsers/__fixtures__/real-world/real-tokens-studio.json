{
  "core": {
    "color": {
      "white": { "value": "#ffffff", "type": "color" },
      "black": { "value": "#000000", "type": "color" },
      "violet": {
        "100": { "value": "#ede9fe", "type": "color" },
        "400": { "value": "#a78bfa", "type": "color" },
        "600": { "value": "#7c3aed", "type": "color", "description": "Primary brand" },
        "700": { "value": "#6d28d9", "type": "color" }
      },
      "neutral": {
        "50": { "value": "#fafafa", "type": "color" },
        "200": { "value": "#e5e5e5", "type": "color" },
        "600": { "value": "#525252", "type": "color" },
        "900": { "value": "#171717", "type": "color" },
        "950": { "value": "#0a0a0a", "type": "color" }
      },
      "overlay": { "value": "rgba({color.black}, 0.5)", "type": "color" }
    },
    "spacing": {
      "base": { "value": "4", "type": "spacing" },
      "xs": { "value": "{spacing.base}", "type": "spacing" },
      "sm": { "value": "{spacing.base} * 2", "type": "spacing" },
      "md": { "value": "{spacing.base} * 4", "type": "spacing" },
      "lg": { "value": "{spacing.md} + {spacing.sm}", "type": "spacing" },
      "xl": { "value": "roundTo({spacing.base} * 2.5, 0)", "type": "spacing" },
      "scale-2": { "value": "8px", "type": "spacing" }
    },
    "sizing": {
      "icon": { "value": "20", "type": "sizing" },
      "control": { "value": "40px", "type": "sizing" }
    },
    "borderRadius": {
      "sm": { "value": "4", "type": "borderRadius" },
      "md": { "value": "{borderRadius.sm} * 2", "type": "borderRadius" },
      "full": { "value": "9999", "type": "borderRadius" }
    },
    "borderWidth": { "default": { "value": "1", "type": "borderWidth" } },
    "opacity": { "disabled": { "value": "50%", "type": "opacity" } },
    "fontFamilies": {
      "sans": { "value": "Inter", "type": "fontFamilies" },
      "mono": { "value": "JetBrains Mono", "type": "fontFamilies" }
    },
    "fontWeights": {
      "regular": { "value": "Regular", "type": "fontWeights" },
      "medium": { "value": "Medium", "type": "fontWeights" },
      "bold": { "value": "Bold", "type": "fontWeights" },
      "numeric": { "value": "600", "type": "fontWeights" }
    },
    "fontSizes": {
      "sm": { "value": "14", "type": "fontSizes" },
      "md": { "value": "16", "type": "fontSizes" },
      "lg": { "value": "{fontSizes.md} * 1.25", "type": "fontSizes" }
    },
    "lineHeights": {
      "body": { "value": "150%", "type": "lineHeights" },
      "heading": { "value": "AUTO", "type": "lineHeights" },
      "md": { "value": "24", "type": "lineHeights" }
    },
    "letterSpacing": { "tight": { "value": "-1%", "type": "letterSpacing" } },
    "boxShadow": {
      "card": {
        "value": [
          { "x": "0", "y": "1", "blur": "2", "spread": "0", "color": "rgba(0,0,0,0.06)", "type": "dropShadow" },
          { "x": "0", "y": "4", "blur": "8", "spread": "-2", "color": "{color.overlay}", "type": "dropShadow" }
        ],
        "type": "boxShadow"
      },
      "inset": { "value": { "x": "0", "y": "1", "blur": "0", "spread": "0", "color": "{color.neutral.200}", "type": "innerShadow" }, "type": "boxShadow" }
    },
    "typography": {
      "body": {
        "value": {
          "fontFamily": "{fontFamilies.sans}",
          "fontWeight": "{fontWeights.regular}",
          "fontSize": "{fontSizes.md}",
          "lineHeight": "{lineHeights.body}",
          "letterSpacing": "0"
        },
        "type": "typography"
      }
    }
  },
  "semantic/light": {
    "bg": {
      "canvas": { "value": "{color.white}", "type": "color" },
      "surface": { "value": "$color.neutral.50", "type": "color" },
      "accent": { "value": "{color.violet.600}", "type": "color" }
    },
    "text": {
      "default": { "value": "{color.neutral.900}", "type": "color" },
      "muted": { "value": "{color.neutral.600}", "type": "color" },
      "on-accent": { "value": "{color.white}", "type": "color" }
    },
    "border": { "default": { "value": "{color.neutral.200}", "type": "color" } }
  },
  "semantic/dark": {
    "bg": {
      "canvas": { "value": "{color.neutral.950}", "type": "color" },
      "surface": { "value": "{color.neutral.900}", "type": "color" },
      "accent": { "value": "{color.violet.400}", "type": "color" }
    },
    "text": {
      "default": { "value": "{color.neutral.50}", "type": "color" },
      "muted": { "value": "{color.neutral.200}", "type": "color" }
    },
    "border": { "default": { "value": "{color.neutral.600}", "type": "color" } }
  },
  "components/button": {
    "button": {
      "bg": { "value": "{bg.accent}", "type": "color" },
      "bg-hover": { "value": "{color.violet.700}", "type": "color" },
      "text": { "value": "{text.on-accent}", "type": "color" },
      "radius": { "value": "{borderRadius.md}", "type": "borderRadius" },
      "padding-x": { "value": "{spacing.md}", "type": "spacing" },
      "height": { "value": "{sizing.control}", "type": "sizing" },
      "missing": { "value": "{color.violet.500}", "type": "color" }
    }
  },
  "$themes": [
    {
      "id": "light-theme",
      "name": "Light",
      "selectedTokenSets": { "core": "source", "semantic/light": "enabled", "components/button": "enabled" }
    },
    {
      "id": "dark-theme",
      "name": "Dark",
      "selectedTokenSets": { "core": "source", "semantic/dark": "enabled", "components/button": "enabled" }
    }
  ],
  "$metadata": { "tokenSetOrder": ["core", "semantic/light", "semantic/dark", "components/button"] }
}
