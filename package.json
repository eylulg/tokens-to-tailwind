{
    "name": "tokens-to-tailwind",
    "private": true,
    "version": "0.1.0",
    "description": "Turn design tokens (W3C DTCG, Figma Variables, Tokens Studio) into a Tailwind CSS 4 theme.",
    "license": "MIT",
    "author": "Eylül Güneş",
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "knip": "knip",
        "relink": "rm -rf node_modules/@eylulg/ui && npm install ../ui --install-links && git checkout -- package-lock.json",
        "prepare": "husky"
    },
    "dependencies": {
        "@eylulg/ui": "file:../ui",
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/vite": "^4.3.5",
        "culori": "^4.0.2",
        "lucide-react": "^1.71.0",
        "react": "^19.3.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.5",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/culori": "^4.0.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.2.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.0",
        "knip": "^6.44.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^7.3.8",
        "vitest": "^5.1.0",
        "vitest-axe": "^0.1.0"
    }
}
